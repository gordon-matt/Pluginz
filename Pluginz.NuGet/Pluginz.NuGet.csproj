<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>Pluginz.Packages</RootNamespace>
		<Description>Search NuGet feeds and install plugins from NuGet packages, with their dependencies, for Pluginz.</Description>
		<PackageTags>plugins;plugin-framework;nuget;nuget-feed;package-installer</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="NuGet.Protocol" />
		<PackageReference Include="System.Security.Cryptography.Pkcs" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Pluginz.Services\Pluginz.Services.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Pluginz.Tests" />
	</ItemGroup>

</Project>
