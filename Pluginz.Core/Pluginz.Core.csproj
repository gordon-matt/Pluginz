<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>Pluginz</RootNamespace>
		<Description>Contracts for Pluginz plugins. Reference this from a plugin project. It has no loader and no UI.</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
	</ItemGroup>

	<ItemGroup>
		<None Include="build\Pluginz.Core.props" Pack="true" PackagePath="build\" />
		<None Include="build\Pluginz.Core.targets" Pack="true" PackagePath="build\" />
	</ItemGroup>

</Project>
