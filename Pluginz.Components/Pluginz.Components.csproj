<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>Pluginz.Components</RootNamespace>
		<Description>Blazor admin for Pluginz. List, install, enable, upload and browse NuGet for plugins.</Description>
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="Heroicsoft.NetForge.Components" Version="1.2.2" />
		<PackageReference Include="Heroicsoft.NetForge.Results" Version="1.2.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Pluginz.NuGet\Pluginz.NuGet.csproj" />
		<ProjectReference Include="..\Pluginz.Services\Pluginz.Services.csproj" />
	</ItemGroup>

</Project>
